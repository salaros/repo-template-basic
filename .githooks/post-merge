#!/bin/sh
# .githooks/post-merge
# After a merge or pull, restore whatever the changed manifests call for (scripts/stacks.tsv).
# Git runs this through core.hooksPath, set once per clone by `sh scripts/githooks-init.sh`.
# To try the dispatch by hand: printf 'package-lock.json\n' | sh scripts/on-manifest-change.sh --dry-run
[ -n "$GIT_DIR" ] || { echo "post-merge is run by Git after a merge, not by hand" >&2; exit 1; }
cd "$(git rev-parse --show-toplevel)" || exit 1
git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD | sh scripts/on-manifest-change.sh
