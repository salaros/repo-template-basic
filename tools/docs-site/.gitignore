# Everything this tool writes. Kept here rather than in the root .gitignore so the folder is
# self-contained: deleting tools/docs-site/ leaves no rules behind for a tool that is gone.
# The chain itself is read live from docs/, so there is no generated content to ignore.

# Astro build output, and its generated types and content cache
dist/
.astro/

# Also covered by the root .gitignore; repeated so this folder stands on its own
node_modules/
